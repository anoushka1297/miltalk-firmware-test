bool allFourDown() {
  return isDown(BTN_A) && isDown(BTN_B) && isDown(BTN_TEST) && isDown(BTN_RESET);
}

// Same page switch the A+B combo does (used only for a very quick A+B tap)
void switchPageFromCombo() {
  currentPage = (currentPage == PAGE_HOME) ? PAGE_ML : PAGE_HOME;
  if (currentPage == PAGE_ML) {
    drawMLPage();
  } else {
    lastAx = -1;
    drawHomeStatic();
  }
}

// Returns true if it handled the buttons this loop (caller should return)
bool handleSendCombo() {
  // An action whose button was released was intentional - stop protecting it
  if (undoArmed && !isDown(undoPin)) undoArmed = false;

  // A+B down: give TEST and RESET a moment to join before the page-switch combo runs
  if (isDown(BTN_A) && isDown(BTN_B) && !allFourDown()) {
    unsigned long t0 = millis();
    while (millis() - t0 < SEND_COMBO_WAIT_MS) {
      if (allFourDown()) break;
      if (!isDown(BTN_A) || !isDown(BTN_B)) {
        // Quick A+B tap released during the wait: do the original page switch
        if (millis() - lastComboSwitch > COMBO_COOLDOWN_MS) {
          lastComboSwitch = millis();
          Serial.println("COMBO pressed");
          prevA = prevB = false;
          switchPageFromCombo();
          return true;
        }
        return false;
      }
      delay(5);
    }
  }

  if (!allFourDown()) return false;

  Serial.println("SEND COMBO pressed");
  if (undoArmed) {
    restoreSnapshot();
    undoArmed = false;
    Serial.println("Undid action triggered by the combo");
  }

  drawStatusBox("SENDING WEIGHTS", "to tester...", COL_ACCENT);
  int r = sendWeights();
  if (r == SEND_OK) {
    char msg[20];
    snprintf(msg, sizeof(msg), "A:%d  B:%d", countA, countB);
    drawStatusBox("SENT TO TESTER!", msg, COL_GOOD);
  } else if (r == SEND_NOT_TRAINED) {
    drawStatusBox("NOTHING TO SEND", "train A and B", COL_BAD);
  } else if (r == SEND_NO_RADIO) {
    drawStatusBox("SEND FAILED", "radio error", COL_BAD);
  } else {
    drawStatusBox("SEND FAILED", "no tester found", COL_BAD);
  }
  delay(1500);

  while (isDown(BTN_A) || isDown(BTN_B) || isDown(BTN_TEST) || isDown(BTN_RESET)) delay(5);
  prevA = prevB = prevTest = prevReset = false;
  lastComboSwitch = millis();

  if (currentPage == PAGE_ML) {
    drawMLPage();
  } else {
    lastAx = -1;
    drawHomeStatic();
  }
  return true;
}
