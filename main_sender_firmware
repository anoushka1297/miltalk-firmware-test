// ----------------- SETUP / LOOP -----------------
void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("\nMiltalk CAMERA KIT (TFT + feedback)");

  pinMode(BTN_A, INPUT_PULLUP);
  pinMode(BTN_B, INPUT_PULLUP);
  pinMode(BTN_TEST, INPUT_PULLUP);
  pinMode(BTN_RESET, INPUT_PULLUP);

  tft.initR(INITR_BLACKTAB);
  tft.setSPISpeed(8000000);
  tft.setRotation(0);
  tft.fillScreen(COL_BG);

  tft.setTextColor(COL_TEXT);
  tft.setCursor(10, 70);
  tft.print("Starting camera...");

  if (!initCamera()) {
    tft.fillScreen(ST77XX_RED);
    tft.setCursor(8, 70);
    tft.setTextColor(COL_TEXT);
    tft.print("CAMERA FAIL");
    tft.setCursor(8, 84);
    tft.print("Check PSRAM=OPI");
    while (true) delay(1000);
  }
  Serial.println("Camera ready.");

  for (int i = 0; i < 10; i++) {
    camera_fb_t* tmp = esp_camera_fb_get();
    if (tmp) esp_camera_fb_return(tmp);
    delay(30);
  }

  resetTraining();

  espNowReady = initEspNow();   // [ADDED] kit still works normally if this fails

  currentPage = PAGE_HOME;
  drawHomeStatic();
}

void loop() {
  if (handleSendCombo()) return;   // [ADDED] 4-button send (checked first)

  if (comboPressed()) {
    currentPage = (currentPage == PAGE_HOME) ? PAGE_ML : PAGE_HOME;
    if (currentPage == PAGE_ML) {
      drawMLPage();
    } else {
      lastAx = -1;
      drawHomeStatic();
    }
    return;
  }

  if (currentPage == PAGE_HOME) {
    animateHome();
    delay(40);
  } else {
    bool changed = false;

    if (feedbackMode) {
      // In feedback mode: A = approve, B = disprove, TEST/RESET = skip
      if (justPressed(BTN_A, prevA))         { armUndo(BTN_A);     handleApprove();  changed = true; }
      if (justPressed(BTN_B, prevB))         { armUndo(BTN_B);     handleDisprove(); changed = true; }
      if (justPressed(BTN_TEST, prevTest))   { armUndo(BTN_TEST);  feedbackMode = false; changed = true; }
      if (justPressed(BTN_RESET, prevReset)) { armUndo(BTN_RESET); resetTraining();  changed = true; }
    } else {
      if (justPressed(BTN_A, prevA))         { armUndo(BTN_A);     trainExample(true);  changed = true; }
      if (justPressed(BTN_B, prevB))         { armUndo(BTN_B);     trainExample(false); changed = true; }
      if (justPressed(BTN_TEST, prevTest))   { armUndo(BTN_TEST);  testExample();       changed = true; }
      if (justPressed(BTN_RESET, prevReset)) { armUndo(BTN_RESET); resetTraining();     changed = true; }
    }

    if (changed) drawMLPage();
    delay(10);
  }
}
