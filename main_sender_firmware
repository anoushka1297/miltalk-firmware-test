// =================== [ADDED] ESP-NOW PROTOCOL (same in tester) ===================
#define KIT_ID        1          // trainer and tester must match
#define PROTO_VERSION 1
#define PKT_MAGIC     0xBEEF
#define PKT_CHUNK     1
#define PKT_ACK       2
#define CHUNK_DATA    200

typedef struct __attribute__((packed)) {
  uint16_t magic; uint8_t type; uint8_t kitId; uint8_t transferId;
  uint8_t seq; uint8_t total; uint16_t len;
  uint32_t crc;                  // CRC32 of the whole payload
  uint8_t data[CHUNK_DATA];
} ChunkPacket;

typedef struct __attribute__((packed)) {
  uint16_t magic; uint8_t type; uint8_t kitId; uint8_t transferId; uint8_t seq;
} AckPacket;

typedef struct __attribute__((packed)) {
  uint16_t version; uint16_t featLen;
  int32_t  countA;  int32_t  countB;
  float sumA[FEAT_LEN];
  float sumB[FEAT_LEN];
} WeightsPayload;

uint32_t crc32(const uint8_t* d, size_t n) {
  uint32_t c = 0xFFFFFFFF;
  for (size_t i = 0; i < n; i++) {
    c ^= d[i];
    for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320 & -(c & 1));
  }
  return ~c;
}

uint8_t broadcastAddr[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
bool espNowReady = false;
WeightsPayload txPayload;
uint8_t txTransferId = 0;
volatile int     lastAckSeq = -1;
volatile uint8_t lastAckId  = 0;

#define SEND_COMBO_WAIT_MS 150

// Undo snapshot: protects training if the combo's first button fired an action
float  snapSumA[FEAT_LEN], snapSumB[FEAT_LEN], snapLastFeat[FEAT_LEN];
int    snapCountA = 0, snapCountB = 0, snapConf = 0;
String snapPred = "-";
bool   snapFeedback = false;
char   snapPredClass = 0;
bool   undoArmed = false;
int    undoPin = -1;

void armUndo(int pin) {
  if (undoArmed) return;                     // keep the earliest snapshot
  memcpy(snapSumA, sumA, sizeof(sumA));
  memcpy(snapSumB, sumB, sizeof(sumB));
  memcpy(snapLastFeat, lastFeat, sizeof(lastFeat));
  snapCountA = countA; snapCountB = countB;
  snapPred = lastPrediction; snapConf = lastConfidence;
  snapFeedback = feedbackMode; snapPredClass = predClass;
  undoArmed = true; undoPin = pin;
}

void restoreSnapshot() {
  memcpy(sumA, snapSumA, sizeof(sumA));
  memcpy(sumB, snapSumB, sizeof(sumB));
  memcpy(lastFeat, snapLastFeat, sizeof(lastFeat));
  countA = snapCountA; countB = snapCountB;
  lastPrediction = snapPred; lastConfidence = snapConf;
  feedbackMode = snapFeedback; predClass = snapPredClass;
}
