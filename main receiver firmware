// ----------------- WEIGHTS STORAGE -----------------
bool payloadValid(const WeightsPayload& w) {
  return w.version == PROTO_VERSION && w.featLen == FEAT_LEN &&
         w.countA > 0 && w.countA <= MAX_EXAMPLES &&
         w.countB > 0 && w.countB <= MAX_EXAMPLES;
}

void applyPayload(const WeightsPayload& w) {
  memcpy(sumA, w.sumA, sizeof(sumA));
  memcpy(sumB, w.sumB, sizeof(sumB));
  countA = w.countA;
  countB = w.countB;
}

void saveWeights(const WeightsPayload& w) {
  prefs.begin("miltalk", false);
  prefs.putBytes("w", &w, sizeof(w));
  prefs.end();
}

bool loadWeights() {
  if (!prefs.begin("miltalk", true)) return false;
  bool ok = false;
  if (prefs.isKey("w") && prefs.getBytesLength("w") == sizeof(WeightsPayload)) {
    WeightsPayload w;
    prefs.getBytes("w", &w, sizeof(w));
    if (payloadValid(w)) { applyPayload(w); ok = true; }
  }
  prefs.end();
  return ok;
}

// ----------------- ESP-NOW RECEIVE -----------------
void onEspNowRecv(const esp_now_recv_info_t* info, const uint8_t* data, int len) {
  if (len != sizeof(ChunkPacket)) return;
  const ChunkPacket* p = (const ChunkPacket*)data;
  if (p->magic != PKT_MAGIC || p->type != PKT_CHUNK || p->kitId != KIT_ID) return;
  if (p->total > 16 || p->seq >= p->total) return;
  size_t off = (size_t)p->seq * CHUNK_DATA;
  if (off + p->len > sizeof(rxBuf)) return;

  if (p->transferId != rxId || p->crc != rxCrc) {   // new transfer
    rxId = p->transferId; rxTotal = p->total; rxCrc = p->crc;
    memset(gotChunk, 0, sizeof(gotChunk));
  }
  memcpy(rxBuf + off, p->data, p->len);
  gotChunk[p->seq] = true;

  AckPacket a = {PKT_MAGIC, PKT_ACK, KIT_ID, p->transferId, p->seq};
  esp_now_send(broadcastAddr, (uint8_t*)&a, sizeof(a));

  bool all = true;
  for (int i = 0; i < rxTotal; i++) if (!gotChunk[i]) { all = false; break; }
  if (all) transferDone = true;
}

bool initEspNow() {
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  if (esp_now_init() != ESP_OK) { Serial.println("ESP-NOW init FAILED"); return false; }
  esp_now_register_recv_cb(onEspNowRecv);
  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, broadcastAddr, 6);
  peer.channel = 0;
  peer.encrypt = false;
  if (esp_now_add_peer(&peer) != ESP_OK) { Serial.println("ESP-NOW add peer FAILED"); return false; }
  Serial.println("ESP-NOW ready");
  return true;
}

void handleIncomingWeights() {
  if (!transferDone) return;
  transferDone = false;

  if (crc32(rxBuf, sizeof(rxBuf)) != rxCrc) { Serial.println("CRC mismatch"); return; }
  WeightsPayload w;
  memcpy(&w, rxBuf, sizeof(w));
  if (!payloadValid(w)) { Serial.println("Payload rejected"); return; }

  applyPayload(w);
  saveWeights(w);
  lastPrediction = "-"; lastConfidence = 0; lastDirection = "";
  Serial.printf("Weights received (A:%d B:%d) - saved\n", countA, countB);

  drawTesterPage();
  char msg[20];
  snprintf(msg, sizeof(msg), "A:%d  B:%d", countA, countB);
  drawStatusBox("WEIGHTS RECEIVED", msg, COL_GOOD);
  delay(1500);
  drawTesterPage();
}

// ----------------- CLASSIFY + POINT -----------------
void classifyAndPoint() {
  if (countA == 0 || countB == 0) {
    drawStatusBox("NO WEIGHTS YET", "send from trainer", COL_BAD);
    delay(1500);
    drawTesterPage();
    return;
  }

  float feat[FEAT_LEN];
  if (!captureFeatures(feat)) { drawTesterPage(); return; }

  // Identical decision + confidence to the trainer's testExample()
  float dA = distToCentroid(feat, sumA, countA);
  float dB = distToCentroid(feat, sumB, countB);
  bool aWins = dA < dB;
  float nr = aWins ? dA : dB;
  float fr = aWins ? dB : dA;
  float conf = (fr + nr > 0) ? (fr - nr) / (fr + nr) * 100.0f : 0;
  lastPrediction = aWins ? "SET A" : "SET B";
  lastConfidence = (int)conf;
  lastDirection  = aWins ? "-> " SERVO_A_LABEL : "-> " SERVO_B_LABEL;
  Serial.printf("Predict %s (%.0f%%) %s\n", lastPrediction.c_str(), conf, lastDirection);

  drawTesterPage();
  servoGoTo(aWins ? SERVO_A_DEG : SERVO_B_DEG);
  servoReturnAt = millis() + SERVO_HOLD_MS;
}

// ----------------- BUTTONS -----------------
bool isDown(int pin) { return digitalRead(pin) == LOW; }

bool justPressed(int pin, bool &prev) {
  bool down = isDown(pin);
  bool edge = false;
  unsigned long now = millis();
  if (down && !prev && (now - lastPress[pin] > DEBOUNCE_MS)) {
    lastPress[pin] = now;
    edge = true;
  }
  prev = down;
  return edge;
}

// ----------------- SETUP / LOOP -----------------
void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("\nMiltalk TESTER KIT");

  pinMode(BTN_A, INPUT_PULLUP);
  pinMode(BTN_B, INPUT_PULLUP);
  pinMode(BTN_TEST, INPUT_PULLUP);
  pinMode(BTN_RESET, INPUT_PULLUP);

  tft.initR(INITR_BLACKTAB);
  tft.setSPISpeed(8000000);
  tft.setRotation(0);
  tft.fillScreen(COL_BG);

  tft.setTextColor(COL_TEXT);
  tft.setCursor(10, 70);
  tft.print("Starting camera...");

  if (!initCamera()) {
    tft.fillScreen(ST77XX_RED);
    tft.setCursor(8, 70);
    tft.setTextColor(COL_TEXT);
    tft.print("CAMERA FAIL");
    tft.setCursor(8, 84);
    tft.print("Check PSRAM=OPI");
    while (true) delay(1000);
  }
  Serial.println("Camera ready.");

  for (int i = 0; i < 10; i++) {
    camera_fb_t* tmp = esp_camera_fb_get();
    if (tmp) esp_camera_fb_return(tmp);
    delay(30);
  }

  // Servo after camera, on its own LEDC timer/channel
  if (servoInit()) servoGoTo(SERVO_CENTER);

  if (loadWeights()) Serial.printf("Loaded saved weights (A:%d B:%d)\n", countA, countB);
  else               Serial.println("No saved weights - waiting for trainer");

  initEspNow();
  drawTesterPage();
}

void loop() {
  handleIncomingWeights();

  if (justPressed(BTN_TEST, prevTest)) classifyAndPoint();

  if (servoReturnAt && millis() >= servoReturnAt) {
    servoReturnAt = 0;
    servoGoTo(SERVO_CENTER);
  }
  if (servoRelaxAt && millis() >= servoRelaxAt) {
    servoRelaxAt = 0;
    servoOff();
  }

  delay(10);
}
