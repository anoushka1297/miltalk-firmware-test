/*
 * Miltalk TESTER (receiver)
 * Hardware: bare ESP32-S3 N16R8 CAM board (OV2640) on breadboard + servo.
 *           No TFT, no PCB buttons.
 *
 * - Receives sumA/sumB/countA/countB from the trainer kit over ESP-NOW
 *   (trainer: hold all 4 buttons). Saved to flash, reloaded at boot.
 * - BOOT button (or 't' over Serial): capture -> identical feature
 *   extraction -> identical nearest-centroid decision -> servo points to
 *   SET A or SET B for a few seconds -> back to centre.
 *
 * ARDUINO IDE SETTINGS:
 *   Board: ESP32S3 Dev Module | PSRAM: OPI PSRAM | Flash: 16MB
 *   Partition: Huge APP | USB CDC On Boot: Enabled
 *   esp32 board package 3.x
 */

#include "esp_camera.h"
#include <WiFi.h>
#include <esp_now.h>
#include <Preferences.h>
#include "driver/ledc.h"

// ----------------- CAMERA PIN MAP (same as trainer PCB) -----------------
#define PWDN_GPIO_NUM   -1
#define RESET_GPIO_NUM  -1
#define XCLK_GPIO_NUM   15
#define SIOD_GPIO_NUM    4
#define SIOC_GPIO_NUM    5
#define Y2_GPIO_NUM     11
#define Y3_GPIO_NUM      9
#define Y4_GPIO_NUM      8
#define Y5_GPIO_NUM     10
#define Y6_GPIO_NUM     12
#define Y7_GPIO_NUM     18
#define Y8_GPIO_NUM     17
#define Y9_GPIO_NUM     16
#define VSYNC_GPIO_NUM   6
#define HREF_GPIO_NUM    7
#define PCLK_GPIO_NUM   13

// ----------------- TRIGGER + STATUS LED -----------------
#define BTN_TRIGGER  0        // BOOT button
#define USE_RGB_LED  1        // set 0 if your board has no RGB LED
#define RGB_LED_PIN  48

// ----------------- SERVO -----------------
#define SERVO_PIN       2
#define SERVO_CENTER    90                              // rest position
#define SERVO_SWING     45                              // safe range either side
#define SERVO_A_DEG     (SERVO_CENTER - SERVO_SWING)    // SET A
#define SERVO_B_DEG     (SERVO_CENTER + SERVO_SWING)    // SET B
#define SERVO_A_LABEL   "LEFT"     // swap if mounted the other way
#define SERVO_B_LABEL   "RIGHT"
#define SERVO_HOLD_MS   3000       // how long it points before returning
#define SERVO_SETTLE_MS 700        // then pulses stop (servo relaxes)
#define SERVO_MIN_US    500
#define SERVO_MAX_US    2400
#define SERVO_LEDC_TIMER LEDC_TIMER_1    // camera uses TIMER_0 / CHANNEL_0
#define SERVO_LEDC_CH    LEDC_CHANNEL_2

// ----------------- CLASSIFIER CONFIG (identical) -----------------
#define FEAT_W 16
#define FEAT_H 16
#define FEAT_LEN (FEAT_W * FEAT_H)
#define MAX_EXAMPLES 20

float sumA[FEAT_LEN];
float sumB[FEAT_LEN];
int   countA = 0;
int   countB = 0;

// =================== ESP-NOW PROTOCOL (same as trainer) ===================
#define KIT_ID        1
#define PROTO_VERSION 1
#define PKT_MAGIC     0xBEEF
#define PKT_CHUNK     1
#define PKT_ACK       2
#define CHUNK_DATA    200

typedef struct __attribute__((packed)) {
  uint16_t magic; uint8_t type; uint8_t kitId; uint8_t transferId;
  uint8_t seq; uint8_t total; uint16_t len;
  uint32_t crc;
  uint8_t data[CHUNK_DATA];
} ChunkPacket;

typedef struct __attribute__((packed)) {
  uint16_t magic; uint8_t type; uint8_t kitId; uint8_t transferId; uint8_t seq;
} AckPacket;

typedef struct __attribute__((packed)) {
  uint16_t version; uint16_t featLen;
  int32_t  countA;  int32_t  countB;
  float sumA[FEAT_LEN];
  float sumB[FEAT_LEN];
} WeightsPayload;

uint32_t crc32(const uint8_t* d, size_t n) {
  uint32_t c = 0xFFFFFFFF;
  for (size_t i = 0; i < n; i++) {
    c ^= d[i];
    for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320 & -(c & 1));
  }
  return ~c;
}

uint8_t broadcastAddr[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

uint8_t  rxBuf[sizeof(WeightsPayload)];
bool     gotChunk[16];
uint8_t  rxId = 0, rxTotal = 0;
uint32_t rxCrc = 0;
volatile bool transferDone = false;

Preferences prefs;

// ----------------- STATE -----------------
unsigned long lastPress = 0;
const unsigned long DEBOUNCE_MS = 250;
bool prevTrigger = false;
unsigned long servoReturnAt = 0;
unsigned long servoRelaxAt = 0;

// ----------------- STATUS LED -----------------
void ledColor(uint8_t r, uint8_t g, uint8_t b) {
#if USE_RGB_LED
  rgbLedWrite(RGB_LED_PIN, r, g, b);
#endif
}

void ledIdle() {
  if (countA > 0 && countB > 0) ledColor(0, 15, 0);   // dim green = ready
  else                          ledColor(15, 0, 0);   // dim red = no weights
}

// ----------------- CAMERA INIT (identical) -----------------
bool initCamera() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_GRAYSCALE;
  config.frame_size = FRAMESIZE_QQVGA;
  config.fb_count = 1;
  config.fb_location = CAMERA_FB_IN_PSRAM;
  config.grab_mode = CAMERA_GRAB_LATEST;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Camera init FAILED 0x%x\n", err);
    return false;
  }

  sensor_t* s = esp_camera_sensor_get();
  if (s) {
    s->set_whitebal(s, 0);
    s->set_awb_gain(s, 0);
    s->set_exposure_ctrl(s, 0);
    s->set_aec2(s, 0);
    s->set_gain_ctrl(s, 0);
    s->set_agc_gain(s, 5);
    s->set_aec_value(s, 300);
    s->set_brightness(s, 0);
    s->set_contrast(s, 0);
  }
  return true;
}

// ----------------- FEATURE EXTRACTION -----------------
// Identical math to the trainer. Only the TFT preview (+ its 2 s hold) is
// removed - it ran after the features were computed, so results are unchanged.
bool captureFeatures(float* out) {
  for (int i = 0; i < 3; i++) {
    camera_fb_t* tmp = esp_camera_fb_get();
    if (tmp) esp_camera_fb_return(tmp);
    delay(30);
  }
  camera_fb_t* fb = esp_camera_fb_get();
  if (!fb) { Serial.println("Capture FAILED"); return false; }

  int srcW = fb->width, srcH = fb->height;
  uint8_t* px = fb->buf;
  int blockW = srcW / FEAT_W; if (blockW < 1) blockW = 1;
  int blockH = srcH / FEAT_H; if (blockH < 1) blockH = 1;

  for (int fy = 0; fy < FEAT_H; fy++) {
    for (int fx = 0; fx < FEAT_W; fx++) {
      long sum = 0; int n = 0;
      for (int by = 0; by < blockH; by++) {
        for (int bx = 0; bx < blockW; bx++) {
          int sx = fx * blockW + bx;
          int sy = fy * blockH + by;
          if (sx < srcW && sy < srcH) { sum += px[sy * srcW + sx]; n++; }
        }
      }
      float avg = (n > 0) ? (float)sum / n : 0.0f;
      out[fy * FEAT_W + fx] = avg / 255.0f;
    }
  }
  esp_camera_fb_return(fb);

  float mean = 0;
  for (int i = 0; i < FEAT_LEN; i++) mean += out[i];
  mean /= FEAT_LEN;
  for (int i = 0; i < FEAT_LEN; i++) out[i] -= mean;
  return true;
}

// ----------------- CLASSIFIER (identical distance) -----------------
float distToCentroid(const float* feat, const float* sum, int count) {
  if (count == 0) return 1e9;
  float d = 0;
  for (int i = 0; i < FEAT_LEN; i++) {
    float c = sum[i] / count;
    float diff = feat[i] - c;
    d += diff * diff;
  }
  return sqrt(d);
}

// ----------------- SERVO (direct LEDC, own timer/channel) -----------------
bool servoInit() {
  ledc_timer_config_t t = {};
  t.speed_mode      = LEDC_LOW_SPEED_MODE;
  t.duty_resolution = LEDC_TIMER_14_BIT;
  t.timer_num       = SERVO_LEDC_TIMER;
  t.freq_hz         = 50;
  t.clk_cfg         = LEDC_AUTO_CLK;
  if (ledc_timer_config(&t) != ESP_OK) { Serial.println("Servo timer FAILED"); return false; }

  ledc_channel_config_t c = {};
  c.gpio_num   = SERVO_PIN;
  c.speed_mode = LEDC_LOW_SPEED_MODE;
  c.channel    = SERVO_LEDC_CH;
  c.timer_sel  = SERVO_LEDC_TIMER;
  c.duty       = 0;
  c.hpoint     = 0;
  if (ledc_channel_config(&c) != ESP_OK) { Serial.println("Servo channel FAILED"); return false; }
  return true;
}

void servoWriteDeg(int deg) {
  deg = constrain(deg, 0, 180);
  uint32_t us = SERVO_MIN_US + ((uint32_t)deg * (SERVO_MAX_US - SERVO_MIN_US)) / 180;
  uint32_t duty = (us * ((1UL << 14) - 1)) / 20000UL;
  ledc_set_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH, duty);
  ledc_update_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH);
}

void servoOff() {   // stop pulses: no straining, no holding current
  ledc_set_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH, 0);
  ledc_update_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH);
}

void servoGoTo(int deg) {
  servoWriteDeg(deg);
  servoRelaxAt = millis() + SERVO_SETTLE_MS;
}

// ----------------- WEIGHTS STORAGE -----------------
bool payloadValid(const WeightsPayload& w) {
  return w.version == PROTO_VERSION && w.featLen == FEAT_LEN &&
         w.countA > 0 && w.countA <= MAX_EXAMPLES &&
         w.countB > 0 && w.countB <= MAX_EXAMPLES;
}

void applyPayload(const WeightsPayload& w) {
  memcpy(sumA, w.sumA, sizeof(sumA));
  memcpy(sumB, w.sumB, sizeof(sumB));
  countA = w.countA;
  countB = w.countB;
}

void saveWeights(const WeightsPayload& w) {
  prefs.begin("miltalk", false);
  prefs.putBytes("w", &w, sizeof(w));
  prefs.end();
}

bool loadWeights() {
  if (!prefs.begin("miltalk", true)) return false;
  bool ok = false;
  if (prefs.isKey("w") && prefs.getBytesLength("w") == sizeof(WeightsPayload)) {
    WeightsPayload w;
    prefs.getBytes("w", &w, sizeof(w));
    if (payloadValid(w)) { applyPayload(w); ok = true; }
  }
  prefs.end();
  return ok;
}

// ----------------- ESP-NOW RECEIVE -----------------
void onEspNowRecv(const esp_now_recv_info_t* info, const uint8_t* data, int len) {
  if (len != sizeof(ChunkPacket)) return;
  const ChunkPacket* p = (const ChunkPacket*)data;
  if (p->magic != PKT_MAGIC || p->type != PKT_CHUNK || p->kitId != KIT_ID) return;
  if (p->total > 16 || p->seq >= p->total) return;
  size_t off = (size_t)p->seq * CHUNK_DATA;
  if (off + p->len > sizeof(rxBuf)) return;

  if (p->transferId != rxId || p->crc != rxCrc) {   // new transfer
    rxId = p->transferId; rxTotal = p->total; rxCrc = p->crc;
    memset(gotChunk, 0, sizeof(gotChunk));
  }
  memcpy(rxBuf + off, p->data, p->len);
  gotChunk[p->seq] = true;

  AckPacket a = {PKT_MAGIC, PKT_ACK, KIT_ID, p->transferId, p->seq};
  esp_now_send(broadcastAddr, (uint8_t*)&a, sizeof(a));

  bool all = true;
  for (int i = 0; i < rxTotal; i++) if (!gotChunk[i]) { all = false; break; }
  if (all) transferDone = true;
}

bool initEspNow() {
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  if (esp_now_init() != ESP_OK) { Serial.println("ESP-NOW init FAILED"); return false; }
  esp_now_register_recv_cb(onEspNowRecv);
  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, broadcastAddr, 6);
  peer.channel = 0;
  peer.encrypt = false;
  if (esp_now_add_peer(&peer) != ESP_OK) { Serial.println("ESP-NOW add peer FAILED"); return false; }
  Serial.println("ESP-NOW ready");
  return true;
}

void handleIncomingWeights() {
  if (!transferDone) return;
  transferDone = false;

  if (crc32(rxBuf, sizeof(rxBuf)) != rxCrc) { Serial.println("CRC mismatch"); return; }
  WeightsPayload w;
  memcpy(&w, rxBuf, sizeof(w));
  if (!payloadValid(w)) { Serial.println("Payload rejected"); return; }

  applyPayload(w);
  saveWeights(w);
  Serial.printf("Weights received (A:%d B:%d) - saved to flash\n", countA, countB);

  for (int i = 0; i < 3; i++) {             // 3 green flashes
    ledColor(0, 60, 0); delay(150);
    ledColor(0, 0, 0);  delay(150);
  }
  ledIdle();
}

// ----------------- CLASSIFY + POINT -----------------
void classifyAndPoint() {
  if (countA == 0 || countB == 0) {
    Serial.println("No weights yet - send from the trainer (hold all 4 buttons)");
    for (int i = 0; i < 2; i++) { ledColor(60, 0, 0); delay(200); ledColor(0, 0, 0); delay(200); }
    ledIdle();
    return;
  }

  ledColor(0, 0, 40);                        // blue = capturing
  float feat[FEAT_LEN];
  if (!captureFeatures(feat)) { ledIdle(); return; }

  // Identical decision + confidence to the trainer's testExample()
  float dA = distToCentroid(feat, sumA, countA);
  float dB = distToCentroid(feat, sumB, countB);
  bool aWins = dA < dB;
  float nr = aWins ? dA : dB;
  float fr = aWins ? dB : dA;
  float conf = (fr + nr > 0) ? (fr - nr) / (fr + nr) * 100.0f : 0;

  Serial.printf("Predict %s (%.0f%%) -> servo %s\n",
                aWins ? "SET A" : "SET B", conf,
                aWins ? SERVO_A_LABEL : SERVO_B_LABEL);

  servoGoTo(aWins ? SERVO_A_DEG : SERVO_B_DEG);
  servoReturnAt = millis() + SERVO_HOLD_MS;
  ledIdle();
}

// ----------------- TRIGGER -----------------
bool triggerPressed() {
  bool down = digitalRead(BTN_TRIGGER) == LOW;
  bool edge = false;
  unsigned long now = millis();
  if (down && !prevTrigger && (now - lastPress > DEBOUNCE_MS)) {
    lastPress = now;
    edge = true;
  }
  prevTrigger = down;
  return edge;
}

// ----------------- SETUP / LOOP -----------------
void setup() {
  Serial.begin(115200);
  delay(1500);
  Serial.println("\nMiltalk TESTER (receiver)");

  pinMode(BTN_TRIGGER, INPUT_PULLUP);
  ledColor(0, 0, 0);

  if (!initCamera()) {
    Serial.println("CAMERA FAIL - check PSRAM=OPI and the camera pin map");
    ledColor(60, 0, 0);
    while (true) delay(1000);
  }
  Serial.println("Camera ready.");

  for (int i = 0; i < 10; i++) {
    camera_fb_t* tmp = esp_camera_fb_get();
    if (tmp) esp_camera_fb_return(tmp);
    delay(30);
  }

  if (servoInit()) servoGoTo(SERVO_CENTER);   // after camera, own timer

  if (loadWeights()) Serial.printf("Loaded saved weights (A:%d B:%d)\n", countA, countB);
  else               Serial.println("No saved weights - waiting for trainer");

  initEspNow();
  ledIdle();
  Serial.println("Ready. Place object, press BOOT (or type 't').");
}

void loop() {
  handleIncomingWeights();

  bool trigger = triggerPressed();
  if (Serial.available() && Serial.read() == 't') trigger = true;
  if (trigger) classifyAndPoint();

  if (servoReturnAt && millis() >= servoReturnAt) {
    servoReturnAt = 0;
    servoGoTo(SERVO_CENTER);
  }
  if (servoRelaxAt && millis() >= servoRelaxAt) {
    servoRelaxAt = 0;
    servoOff();
  }

  delay(10);
}
