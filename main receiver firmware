// ----------------- CLASSIFIER CONFIG (identical) -----------------
#define FEAT_W 16
#define FEAT_H 16
#define FEAT_LEN (FEAT_W * FEAT_H)
#define MAX_EXAMPLES 20

float sumA[FEAT_LEN];
float sumB[FEAT_LEN];
int   countA = 0;
int   countB = 0;

String lastPrediction = "-";
int    lastConfidence  = 0;
const char* lastDirection = "";

// =================== ESP-NOW PROTOCOL (same as trainer) ===================
#define KIT_ID        1
#define PROTO_VERSION 1
#define PKT_MAGIC     0xBEEF
#define PKT_CHUNK     1
#define PKT_ACK       2
#define CHUNK_DATA    200

typedef struct __attribute__((packed)) {
  uint16_t magic; uint8_t type; uint8_t kitId; uint8_t transferId;
  uint8_t seq; uint8_t total; uint16_t len;
  uint32_t crc;
  uint8_t data[CHUNK_DATA];
} ChunkPacket;

typedef struct __attribute__((packed)) {
  uint16_t magic; uint8_t type; uint8_t kitId; uint8_t transferId; uint8_t seq;
} AckPacket;

typedef struct __attribute__((packed)) {
  uint16_t version; uint16_t featLen;
  int32_t  countA;  int32_t  countB;
  float sumA[FEAT_LEN];
  float sumB[FEAT_LEN];
} WeightsPayload;

uint32_t crc32(const uint8_t* d, size_t n) {
  uint32_t c = 0xFFFFFFFF;
  for (size_t i = 0; i < n; i++) {
    c ^= d[i];
    for (int k = 0; k < 8; k++) c = (c >> 1) ^ (0xEDB88320 & -(c & 1));
  }
  return ~c;
}

uint8_t broadcastAddr[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

// Reassembly state (written in the ESP-NOW callback)
uint8_t  rxBuf[sizeof(WeightsPayload)];
bool     gotChunk[16];
uint8_t  rxId = 0, rxTotal = 0;
uint32_t rxCrc = 0;
volatile bool transferDone = false;

Preferences prefs;

// ----------------- BUTTON STATE -----------------
unsigned long lastPress[49] = {0};
const unsigned long DEBOUNCE_MS = 250;
bool prevTest = false;

// ----------------- SERVO STATE -----------------
unsigned long servoReturnAt = 0;
unsigned long servoRelaxAt = 0;

// ----------------- CAMERA INIT (identical) -----------------
bool initCamera() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_GRAYSCALE;
  config.frame_size = FRAMESIZE_QQVGA;
  config.fb_count = 1;
  config.fb_location = CAMERA_FB_IN_PSRAM;
  config.grab_mode = CAMERA_GRAB_LATEST;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("Camera init FAILED 0x%x\n", err);
    return false;
  }

  sensor_t* s = esp_camera_sensor_get();
  if (s) {
    s->set_whitebal(s, 0);
    s->set_awb_gain(s, 0);
    s->set_exposure_ctrl(s, 0);
    s->set_aec2(s, 0);
    s->set_gain_ctrl(s, 0);
    s->set_agc_gain(s, 5);
    s->set_aec_value(s, 300);
    s->set_brightness(s, 0);
    s->set_contrast(s, 0);
  }
  return true;
}

// ----------------- CAPTURE PREVIEW (identical) -----------------
void drawFramePreview(camera_fb_t* fb) {
  int srcW = fb->width, srcH = fb->height;
  uint8_t* px = fb->buf;

  int dstW = SCR_W;
  int dstH = (srcH * dstW) / srcW;
  int offsetY = (SCR_H - dstH) / 2;

  tft.fillScreen(ST77XX_BLACK);

  for (int dy = 0; dy < dstH; dy++) {
    for (int dx = 0; dx < dstW; dx++) {
      int sx = (dx * srcW) / dstW;
      int sy = (dy * srcH) / dstH;
      uint8_t g = px[sy * srcW + sx];
      uint16_t color = ((g & 0xF8) << 8) | ((g & 0xFC) << 3) | (g >> 3);
      tft.drawPixel(dx, offsetY + dy, color);
    }
  }

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(1);
  tft.setCursor(4, 4);
  tft.print("captured");
}

// ----------------- FEATURE EXTRACTION (identical) -----------------
bool captureFeatures(float* out) {
  for (int i = 0; i < 3; i++) {
    camera_fb_t* tmp = esp_camera_fb_get();
    if (tmp) esp_camera_fb_return(tmp);
    delay(30);
  }
  camera_fb_t* fb = esp_camera_fb_get();
  if (!fb) { Serial.println("Capture FAILED"); return false; }

  int srcW = fb->width, srcH = fb->height;
  uint8_t* px = fb->buf;
  int blockW = srcW / FEAT_W; if (blockW < 1) blockW = 1;
  int blockH = srcH / FEAT_H; if (blockH < 1) blockH = 1;

  for (int fy = 0; fy < FEAT_H; fy++) {
    for (int fx = 0; fx < FEAT_W; fx++) {
      long sum = 0; int n = 0;
      for (int by = 0; by < blockH; by++) {
        for (int bx = 0; bx < blockW; bx++) {
          int sx = fx * blockW + bx;
          int sy = fy * blockH + by;
          if (sx < srcW && sy < srcH) { sum += px[sy * srcW + sx]; n++; }
        }
      }
      float avg = (n > 0) ? (float)sum / n : 0.0f;
      out[fy * FEAT_W + fx] = avg / 255.0f;
    }
  }
  drawFramePreview(fb);
  delay(2000);
  esp_camera_fb_return(fb);

  float mean = 0;
  for (int i = 0; i < FEAT_LEN; i++) mean += out[i];
  mean /= FEAT_LEN;
  for (int i = 0; i < FEAT_LEN; i++) out[i] -= mean;
  return true;
}

// ----------------- CLASSIFIER (identical distance) -----------------
float distToCentroid(const float* feat, const float* sum, int count) {
  if (count == 0) return 1e9;
  float d = 0;
  for (int i = 0; i < FEAT_LEN; i++) {
    float c = sum[i] / count;
    float diff = feat[i] - c;
    d += diff * diff;
  }
  return sqrt(d);
}

// ----------------- SERVO (direct LEDC, timer 1 / channel 2) -----------------
bool servoInit() {
  ledc_timer_config_t t = {};
  t.speed_mode      = LEDC_LOW_SPEED_MODE;
  t.duty_resolution = LEDC_TIMER_14_BIT;
  t.timer_num       = SERVO_LEDC_TIMER;
  t.freq_hz         = 50;
  t.clk_cfg         = LEDC_AUTO_CLK;
  if (ledc_timer_config(&t) != ESP_OK) { Serial.println("Servo timer FAILED"); return false; }

  ledc_channel_config_t c = {};
  c.gpio_num   = SERVO_PIN;
  c.speed_mode = LEDC_LOW_SPEED_MODE;
  c.channel    = SERVO_LEDC_CH;
  c.timer_sel  = SERVO_LEDC_TIMER;
  c.duty       = 0;
  c.hpoint     = 0;
  if (ledc_channel_config(&c) != ESP_OK) { Serial.println("Servo channel FAILED"); return false; }
  return true;
}

void servoWriteDeg(int deg) {
  deg = constrain(deg, 0, 180);
  uint32_t us = SERVO_MIN_US + ((uint32_t)deg * (SERVO_MAX_US - SERVO_MIN_US)) / 180;
  uint32_t duty = (us * ((1UL << 14) - 1)) / 20000UL;
  ledc_set_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH, duty);
  ledc_update_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH);
}

void servoOff() {   // stop pulses: servo relaxes, no straining/current draw
  ledc_set_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH, 0);
  ledc_update_duty(LEDC_LOW_SPEED_MODE, SERVO_LEDC_CH);
}

void servoGoTo(int deg) {
  servoWriteDeg(deg);
  servoRelaxAt = millis() + SERVO_SETTLE_MS;
}

